[Unit]
Description=TRMNL Claude Code Usage - log pusher (runs on your Claude Code machine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yoshi
WorkingDirectory=/home/yoshi/git/tmnl-Claude
# The ingest server's public URL and the shared secret (must match ingest).
Environment=INGEST_URL=https://your-box.example:2524
Environment=INGEST_SECRET=CHANGE_ME
# How often to scan + push (seconds).
Environment=PUSH_INTERVAL=120
# Defaults to ~/.claude/projects; override if needed.
# Environment=CLAUDE_PROJECTS_DIR=/home/yoshi/.claude/projects
ExecStart=/usr/bin/node src/pusher.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
