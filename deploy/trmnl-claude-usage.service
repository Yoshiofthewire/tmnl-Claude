[Unit]
Description=TRMNL Claude Code Usage plugin
After=network.target

[Service]
Type=simple
# Adjust User and paths to your environment.
User=yoshi
WorkingDirectory=/home/yoshi/git/tmnl-Claude
Environment=PORT=2523
Environment=TZ=America/New_York
Environment=CLAUDE_PLAN=Claude Pro
# Weekly reset anchor (your local time) + calibrated limits (~33%/83% at setup).
Environment=WEEK_RESET=Tue 9am
Environment=SESSION_LIMIT=102m
Environment=WEEK_LIMIT=660m
# Optional: point at synced logs if Claude Code runs elsewhere.
# Environment=CLAUDE_PROJECTS_DIR=/home/yoshi/.claude/projects
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
