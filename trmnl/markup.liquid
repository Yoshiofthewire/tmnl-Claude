{% comment %}
  TRMNL private-plugin markup (Polling strategy).
  Point the plugin's polling URL at your plugin server's /data.json and paste
  this into the "Markup" editor. All formatting is pre-computed in the JSON
  `display` object, so this template only interpolates strings.
{% endcomment %}
<style>
  .cc * { margin:0; padding:0; box-sizing:border-box; }
  .cc { width:800px; height:480px; background:#fff; color:#111;
    font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    text-rendering:optimizeLegibility;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    display:flex; flex-direction:column; padding:16px 24px 0; }
  .cc .header { display:flex; align-items:baseline; justify-content:space-between;
    border-bottom:2px solid #111; padding-bottom:9px; }
  .cc .htitle { font-size:22px; font-weight:800; letter-spacing:.5px; }
  .cc .plan { border:2px solid #111; border-radius:20px; padding:3px 14px;
    font-size:13px; font-weight:800; letter-spacing:.4px; text-transform:uppercase; }
  .cc .gauges { padding:16px 0 6px; display:flex; flex-direction:column; gap:15px; }
  .cc .ghead { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:5px; }
  .cc .glabel { font-size:15px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase; }
  .cc .gmeta { font-size:13px; font-weight:600; color:#666; }
  .cc .gbar { height:20px; background:#e2e2e2; border:1px solid #111; border-radius:4px; overflow:hidden; }
  .cc .gfill { height:100%; background:#111; }
  .cc .gfoot { display:flex; justify-content:space-between; margin-top:5px; align-items:baseline; }
  .cc .gused { font-size:22px; font-weight:800; font-variant-numeric:tabular-nums; letter-spacing:-.5px; }
  .cc .gleft { font-size:14px; font-weight:600; color:#666; }
  .cc .mid { flex:1; display:flex; gap:24px; padding:8px 0 4px; }
  .cc .models { flex:1.5; }
  .cc .sess { flex:1; border-left:2px solid #ddd; padding-left:22px; }
  .cc .subtitle { font-size:12px; font-weight:800; letter-spacing:2px; text-transform:uppercase; margin-bottom:10px; }
  .cc .mrow { display:flex; align-items:center; gap:10px; margin-bottom:9px; }
  .cc .mname { font-size:13px; font-weight:700; width:88px; }
  .cc .mbar { flex:1; height:12px; background:#e2e2e2; border:1px solid #111; border-radius:3px; overflow:hidden; }
  .cc .mfill { height:100%; background:#111; }
  .cc .mpct { font-size:13px; font-weight:700; font-variant-numeric:tabular-nums; width:36px; text-align:right; }
  .cc .mempty { font-size:13px; color:#888; }
  .cc .srow { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8px; }
  .cc .sk { font-size:12px; font-weight:600; color:#666; text-transform:uppercase; letter-spacing:.5px; }
  .cc .sv { font-size:20px; font-weight:800; font-variant-numeric:tabular-nums; }
  .cc .insight { display:flex; align-items:baseline; gap:8px; font-size:13px; color:#333;
    border-top:1px solid #ddd; padding-top:8px; margin-bottom:4px; }
  .cc .ipct { font-weight:800; font-size:14px; }
  .cc .footer { display:flex; align-items:center; justify-content:space-between;
    border-top:2px solid #111; padding:9px 0 12px; margin-top:auto; }
  .cc .brand { display:flex; align-items:center; gap:9px; }
  .cc .brand .name { font-size:15px; font-weight:800; letter-spacing:.3px; }
  .cc .updated { font-size:13px; color:#555; font-weight:600; font-variant-numeric:tabular-nums; }
  .cc .updated b { color:#111; }
  .cc .stale { color:#111; font-weight:800; }
  .cc .notice { flex:1; display:flex; flex-direction:column; justify-content:center; gap:12px; }
  .cc .ntitle { font-size:30px; font-weight:800; letter-spacing:-.5px; }
  .cc .nsub { font-size:16px; color:#555; font-weight:600; }
  .cc .nurl { font-size:18px; font-weight:800; font-family:"SF Mono", Menlo, monospace; }
</style>

<div class="cc">
  <div class="header">
    <div class="htitle">{{ display.long_date }}</div>
    <div class="plan">{{ display.plan }}</div>
  </div>

  {% if display.authenticated %}
    <div class="gauges">
      <div class="gauge">
        <div class="ghead"><span class="glabel">Session</span><span class="gmeta">{{ display.session.resets | default: '—' }}</span></div>
        <div class="gbar"><div class="gfill" style="width:{{ display.session.pct_used }}%"></div></div>
        <div class="gfoot"><span class="gused">{{ display.session.used_text }}</span><span class="gleft">{{ display.session.left_text }}</span></div>
      </div>
      <div class="gauge">
        <div class="ghead"><span class="glabel">Week · all models</span><span class="gmeta">{{ display.week.resets | default: '—' }}</span></div>
        <div class="gbar"><div class="gfill" style="width:{{ display.week.pct_used }}%"></div></div>
        <div class="gfoot"><span class="gused">{{ display.week.used_text }}</span><span class="gleft">{{ display.week.left_text }}</span></div>
      </div>
    </div>

    <div class="mid">
      <div class="models">
        <div class="subtitle">Per-model · this week</div>
        {% if display.has_models %}
          {% for m in display.models %}
            <div class="mrow">
              <span class="mname">{{ m.label }}</span>
              <div class="mbar"><div class="mfill" style="width:{{ m.width }}%"></div></div>
              <span class="mpct">{{ m.pct_text }}</span>
            </div>
          {% endfor %}
        {% else %}
          <div class="mempty">No per-model breakdown available.</div>
        {% endif %}
      </div>
      <div class="sess">
        <div class="subtitle">Session</div>
        <div class="srow"><span class="sk">Cost</span><span class="sv">{{ display.session_cost }}</span></div>
        <div class="srow"><span class="sk">API time</span><span class="sv">{{ display.api_duration }}</span></div>
        <div class="srow"><span class="sk">Wall time</span><span class="sv">{{ display.wall_duration }}</span></div>
      </div>
    </div>

    {% if display.insight %}
      <div class="insight"><span class="ipct">{{ display.insight.pct }}</span><span>{{ display.insight.summary }}</span></div>
    {% endif %}
  {% else %}
    <div class="notice">
      {% if display.error and display.error != 'not authenticated' %}
        <div class="ntitle">Can't reach the usage dashboard</div>
        <div class="nsub">{{ display.error }}</div>
      {% else %}
        <div class="ntitle">Usage dashboard not connected</div>
        <div class="nsub">Log in on the dashboard to start showing data:</div>
      {% endif %}
      {% if display.api_url %}<div class="nurl">{{ display.api_url }}</div>{% endif %}
    </div>
  {% endif %}

  <div class="footer">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#111" stroke-width="1.25" stroke-linecap="round">
          <line x1="12" y1="8.9" x2="12" y2="1.8"/><line x1="12" y1="15.1" x2="12" y2="22.2"/>
          <line x1="8.9" y1="12" x2="1.8" y2="12"/><line x1="15.1" y1="12" x2="22.2" y2="12"/>
          <line x1="9.8" y1="9.8" x2="5.2" y2="5.2"/><line x1="14.2" y1="14.2" x2="18.8" y2="18.8"/>
          <line x1="14.2" y1="9.8" x2="18.8" y2="5.2"/><line x1="9.8" y1="14.2" x2="5.2" y2="18.8"/>
          <line x1="10.6" y1="9.2" x2="8.4" y2="3.4"/><line x1="13.4" y1="14.8" x2="15.6" y2="20.6"/>
          <line x1="9.2" y1="13.4" x2="3.4" y2="15.6"/><line x1="14.8" y1="10.6" x2="20.6" y2="8.4"/>
        </g>
      </svg>
      <span class="name">Claude Code Usage</span>
    </div>
    <div class="updated">Updated <b>{{ display.updated_time }}</b>{% if display.updated_date %} · {{ display.updated_date }}{% endif %}{% if display.stale %} · <span class="stale">stale</span>{% endif %}</div>
  </div>
</div>
