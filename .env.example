# Copy to .env and adjust. The plugin server loads .env automatically.

# REQUIRED: base URL of the Claude Usage Dashboard API to pull from.
# The plugin fetches {USAGE_API_URL}/api/usage.
USAGE_API_URL=http://your-dashboard:8080

# Port / interface the plugin server listens on (what TRMNL fetches).
PORT=2523
HOST=0.0.0.0

# Fallback plan label for the top-right badge. Used only when the API doesn't
# report a plan (it usually does — shown as "Claude <tier>").
CLAUDE_PLAN=Claude Pro

# Timezone for every date/time on the screen: the header date, the updated
# stamp, and the "Resets …" times (converted from the zone the dashboard
# reports into this one).
TZ=America/New_York

# Optional: how long to wait for the usage API before falling back (ms).
# USAGE_API_TIMEOUT=8000

# Optional: one HTTP header sent when polling the usage API, in "Name: Value"
# form. Use it to get through an auth boundary / reverse proxy in front of the
# dashboard (e.g. a bearer token or API key).
# USAGE_API_HEADER=Authorization: Bearer your-token
