# Copy to .env (or export these) and adjust. All are optional.

# Port / interface the plugin server listens on.
PORT=2523
HOST=0.0.0.0

# Where Claude Code writes its transcript logs. Defaults to ~/.claude/projects.
# Point this at a synced copy if TRMNL's server runs on a different machine.
CLAUDE_PROJECTS_DIR=/home/you/.claude/projects

# Plan label shown in the top-right badge (free text).
CLAUDE_PLAN=Claude Pro

# Timezone. Must be YOUR local zone — it drives both the display and the weekly
# reset anchor below (they have to agree).
TZ=America/New_York

# Weekly reset anchor for the "week remaining" gauge, in your local time.
# Format: "<weekday> <hour>[am|pm]" e.g. "Tue 9am". Unset -> rolling 7 days.
WEEK_RESET=Tue 9am

# Usage limits for the "remaining" gauges (tokens; k/m/b suffixes). When set,
# the gauges show true remaining + "% used". These are calibrated so the plugin
# reads ~33% this session / ~83% this week at the time of setup; adjust to taste
# or to your plan's real allowances. Unset -> gauges read "% of peak" instead.
SESSION_LIMIT=102m
WEEK_LIMIT=660m

# ---------------------------------------------------------------------------
# Optional: push logs from your PC to an always-on box instead of file-syncing.
# ---------------------------------------------------------------------------
# Shared secret for the ingest server + pusher (must match on both). Generate:
#   openssl rand -hex 32
# INGEST_SECRET=

# --- Ingest server (runs on the always-on box: `npm run ingest`) ---
# INGEST_PORT=2524
# INGEST_DIR=/home/you/.claude-usage/received
# Then run the display server with CLAUDE_PROJECTS_DIR=$INGEST_DIR.

# --- Pusher worker (runs on your Claude Code machine: `npm run push`) ---
# INGEST_URL=https://your-box.example:2524
# PUSH_INTERVAL=120
